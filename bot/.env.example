# ============================================================
# 페이퍼 트레이딩 (시뮬레이션) 단계에서는 아래 3개만 있으면 됩니다
# ============================================================

# Binance API (시세 감시용 - 주문 X)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# OKX API (백업 시세 감시용)
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ============================================================
# 실거래 전환 시 추가 필요 (페이퍼 트레이딩 단계에서는 비워두세요)
# ============================================================

# 팬텀 월렛 개인키
# 팬텀 → 설정 → 보안/개인정보 → 개인키 내보내기
# 절대 타인에게 공유 금지! GitHub에 절대 올리지 마세요!
POLYGON_PRIVATE_KEY=

# Polymarket CLOB API (실거래 시 필요)
# polymarket.com → 프로필 → API 설정 → 지갑 서명으로 생성
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# 텔레그램 알림 (선택사항)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
